{
  "name": "lia",
  "version": "0.1.0",
  "private": true,
  "description": "Lia — portal integrador em aneety.com para a plataforma multi-repo Supabase/Postgres.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @lia/web dev",
    "dev:web": "pnpm --filter @lia/web dev",
    "build": "pnpm --filter @lia/web build",
    "build:web": "pnpm --filter @lia/web build",
    "lint": "pnpm --filter @lia/web lint",
    "test": "pnpm --filter @lia/web test && pnpm test:runtime-contract",
    "test:runtime-contract": "node scripts/validate-runtime-contract.mjs",
    "preview:web": "pnpm --filter @lia/web preview",
    "test:e2e": "playwright test",
    "build:cloudflare": "VITE_PUBLIC_BASE_PATH=/ VITE_API_URL=https://api.aneety.com pnpm --filter @lia/web build",
    "deploy:cloudflare": "pnpm build:cloudflare && pnpm dlx wrangler@latest pages deploy apps/web/dist --project-name=lia --branch=main"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@supabase/supabase-js": "^2.106.2"
  }
}
